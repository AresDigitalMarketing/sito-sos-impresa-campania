{#- Link ai profili social: gli indirizzi si cambiano dal pannello, in Impostazioni → Dati dell’associazione e contatti -#}
<ul class="social">
  {%- if site.facebook %}
  <li><a href="{{ site.facebook }}" target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1877F2"/><path d="M13.3 19v-6h2l.3-2.4h-2.3V9.1c0-.7.2-1.1 1.2-1.1h1.2V5.9a16 16 0 0 0-1.8-.1c-1.8 0-3 1.1-3 3.1v1.7h-2V13h2v6z" fill="#fff"/></svg>Facebook</a></li>
  {%- endif %}
  {%- if site.instagram %}
  <li><a href="{{ site.instagram }}" target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#D6247A"/><rect x="5" y="5" width="14" height="14" rx="4" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="12" cy="12" r="3.2" fill="none" stroke="#fff" stroke-width="1.8"/><circle cx="16.3" cy="7.7" r="1" fill="#fff"/></svg>Instagram</a></li>
  {%- endif %}
  {%- if site.linkedin %}
  <li><a href="{{ site.linkedin }}" target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#0A66C2"/><path d="M7.1 9.6H4.7V19h2.4V9.6zM5.9 5.2a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8zM19.3 13.6c0-2.7-1.4-4.2-3.6-4.2-1.5 0-2.3.8-2.7 1.5V9.6h-2.3V19H13v-5c0-1.3.6-2.2 1.8-2.2 1.2 0 1.8.8 1.8 2.2v5h2.7v-5.4z" fill="#fff"/></svg>LinkedIn</a></li>
  {%- endif %}
  {%- if site.youtube %}
  <li><a href="{{ site.youtube }}" target="_blank" rel="noopener"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4.5" width="22" height="15" rx="4.5" fill="#FF0000"/><path d="M10 9v6l5.2-3z" fill="#fff"/></svg>YouTube</a></li>
  {%- endif %}
</ul>
