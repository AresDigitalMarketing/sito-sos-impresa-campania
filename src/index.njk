---
layout: layouts/base.njk
---
{%- import "schede.njk" as s -%}
<section class="apertura apertura-alta">
  <div class="apertura-testo">
    <h1>{{ home.titolo }}</h1>
    <p class="intro">{{ home.testo }}</p>
    <div class="pulsanti">
      <a class="pulsante rosso" href="https://wa.me/39{{ site.cellulare | replace(' ', '') }}" target="_blank" rel="noopener">Contattaci</a>
    </div>
  </div>
  <figure class="apertura-foto">
    <img src="/uploads/home-passaggio-consegne-sos-campania.webp?v=2" alt="Stretta di mano tra i rappresentanti di SOS Impresa Campania dietro il cartello «Questa è una impresa Antiracket»" width="1600" height="1777">
  </figure>
</section>

<section class="adesioni" aria-label="Convenzione e Patto Antiracket">
  <a class="adesione rossa" href="/patto-antiracket/">
    <small>Per le imprese edili</small>
    <strong>Patto Antiracket</strong>
    <span>Adesione libera e senza costi: l’impresa si impegna a denunciare, l’associazione offre informazione, accompagnamento e assistenza.</span>
    <em>Scopri come aderire →</em>
  </a>
  <a class="adesione blu" href="/convenzioniantiracket/">
    <small>Per i commercianti</small>
    <strong>Convenzione Antiracket</strong>
    <span>Un’iniziativa gratuita rivolta agli operatori commerciali della Campania per prevenire racket e usura e sostenere chi è vittima di estorsioni o ricatti.</span>
    <em>Scopri come aderire →</em>
  </a>
</section>

<section class="sezione" aria-labelledby="cosa">
  <div class="contenitore colonne-cosa">
    <div class="cosa-testa">
      <h2 id="cosa">Cosa facciamo</h2>
      <p>Tutti i nostri servizi di accompagnamento sono gratuiti e riservati.</p>
      <a class="freccia" href="/chi-siamo/">Chi siamo →</a>
    </div>
    <ol class="elenco-cosa">
      {%- for a in home.attivita %}
      <li><h3>{{ a.titolo }}</h3><p>{{ a.testo }}</p></li>
      {%- endfor %}
    </ol>
  </div>
</section>

{%- if collections.notizie.length %}
{%- set prima = collections.notizie[0] %}
<section class="sezione con-filo" aria-labelledby="notizie">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="notizie">Notizie</h2>
      <a class="freccia" href="/notizie/">Tutte le notizie →</a>
    </div>
    <div class="giornale">
      <a class="apertura-notizia" href="{{ prima.url }}">
        <img src="{{ prima.data.image }}" alt="{{ prima.data.image_alt or '' }}" loading="lazy" decoding="async">
        <time datetime="{{ prima.date | dataIso }}">{{ prima.date | dataIt }}</time>
        <span class="titolo">{{ prima.data.title }}</span>
      </a>
      <ul class="altre-notizie">
        {%- for n in collections.notizie | primi(4) %}{% if not loop.first %}
        <li><a href="{{ n.url }}">
          <img src="{{ n.data.image }}" alt="" loading="lazy" decoding="async">
          <span><time datetime="{{ n.date | dataIso }}">{{ n.date | dataIt }}</time><b>{{ n.data.title }}</b></span>
        </a></li>
        {%- endif %}{% endfor %}
      </ul>
    </div>
  </div>
</section>
{%- endif %}

{%- if collections.comunicati.length %}
<section class="sezione con-filo" aria-labelledby="comunicati">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="comunicati">Ultimi comunicati stampa</h2>
      <a class="freccia" href="/comunicati-stampa/">Tutti i comunicati →</a>
    </div>
    <div class="griglia stretta">
      {%- for c in collections.comunicati | primi(4) %}{{ s.comunicato(c) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="sezione" aria-labelledby="pubblicazioni">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="pubblicazioni">Pubblicazioni</h2>
      <a class="freccia" href="/pubblicazioni/">Tutte le pubblicazioni →</a>
    </div>
    <div class="copertine">
      <a href="/wp-content/uploads/2026/09/Speciale-Libero-Grassi-35-anni-dopo.pdf" target="_blank" rel="noopener"><img src="/wp-content/uploads/2026/09/Numero-Speciale-Libero-Grassi-scaled.jpg" alt="" loading="lazy"><span>Speciale: Libero Grassi<br>35 anni dopo</span></a>
      <a href="/wp-content/uploads/2026/04/EXE_Fumetto_Mauro-3mb_compressed.pdf" target="_blank" rel="noopener"><img src="/wp-content/uploads/2026/04/Locandina-fumetto.jpeg" alt="" loading="lazy"><span>Fumetto Antiracket:<br>La scelta di Mauro</span></a>
      <a href="/wp-content/uploads/2026/01/Locandina-sito-testo.pdf" target="_blank" rel="noopener"><img src="/uploads/pubblicazioni/giornata-nazionale-antiracket.webp" alt="" loading="lazy"><span>Giornata Nazionale Antiracket</span></a>
      <a href="/wp-content/uploads/2025/12/EXE_Fumetto_Massimo_cut.pdf" target="_blank" rel="noopener"><img src="/uploads/pubblicazioni/fumetto-massimo.webp" alt="" loading="lazy"><span>Fumetto Antiracket:<br>La storia di Massimo</span></a>
    </div>
  </div>
</section>

<section class="sezione con-filo" aria-labelledby="sedi">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="sedi">Dove siamo</h2>
      <a class="freccia" href="/contatti/">Contatti →</a>
    </div>
    {% include "sedi.njk" %}
  </div>
</section>
